# Copy this file to .env and fill in your own MongoDB Atlas connection
# string. .env is listed in .gitignore, so your real credentials are
# never committed to Git -- only this example file is.
#
# In MongoDB Atlas: Database > Connect > Drivers, copy the connection
# string, replace <password> with your database user's password, and
# add the database name ("travlr") right before the "?" in the URL.

DB_URI=mongodb+srv://<username>:<password>@<your-cluster-url>/travlr?retryWrites=true&w=majority
